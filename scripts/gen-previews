#!/usr/bin/env python3
import argparse
import pathlib
import shutil


ROOT = pathlib.Path(__file__).resolve().parents[1]
BASELINE = ROOT / "tests" / "visual-baseline"
ASSETS = ROOT / "assets"
THEMES = ("sky", "sunset", "forest", "midnight", "violet", "graphite")

# README preview asset <- CI-rendered baseline page.
PREVIEWS = {
    "preview-sky-p1-01.png": "slides-sky-1.png",
    "preview-sky-p5-05.png": "slides-sky-7.png",
    "preview-sunset-p1-01.png": "slides-sunset-1.png",
    "preview-sunset-p5-05.png": "slides-sunset-5.png",
    **{f"preview-theme-{theme}-p1-01.png": f"theme-{theme}-1.png" for theme in THEMES},
}


def main():
    parser = argparse.ArgumentParser(description="Copy README preview PNGs from the adopted CI visual baseline.")
    parser.parse_args()

    ASSETS.mkdir(exist_ok=True)
    for target, source in PREVIEWS.items():
        shutil.copyfile(BASELINE / source, ASSETS / target)

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
