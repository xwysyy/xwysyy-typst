#!/usr/bin/env bash
# Compile a deck, extract its layout telemetry, and run the checker.
#
#   scripts/slide-telemetry examples/layout-demo.typ
#   scripts/slide-telemetry examples/layout-demo.typ --format json --error-only
#
# Everything after the deck path is forwarded to scripts/slide-check.py.
set -euo pipefail

if [ "$#" -lt 1 ]; then
  echo "usage: slide-telemetry <deck.typ> [check args...]" >&2
  exit 2
fi

deck="$1"
shift

root="$(cd "$(dirname "$0")/.." && pwd)"
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

typst compile --root "$root" "$deck" "$tmp/deck.pdf"
typst query --root "$root" "$deck" '<xwysyy-slide-layout>' --field value > "$tmp/layout.json"
exec python3 "$root/scripts/slide-check.py" "$tmp/layout.json" "$@"
